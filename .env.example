# elecmockolla settings. Edited by the app (Settings) or by hand.
# CLI: `npm run serve` reads this file. Environment variables override it.

# Address to listen on. 0.0.0.0 to accept other machines.
MOCKOLLA_HOST=127.0.0.1
# Port. 11434 is the real Ollama port.
MOCKOLLA_PORT=11434
# Requests generated at the same time.
MOCKOLLA_NUM_PARALLEL=4
# Requests that may wait for a slot; more get 503.
MOCKOLLA_MAX_QUEUE=512
# Time to first token (ms).
MOCKOLLA_TTFT_MS=350
# Tokens per second. 0 = no delay.
MOCKOLLA_TPS=30
# Random spread of every delay, 0..1.
MOCKOLLA_JITTER=0.2
# Model load time on first use (ms).
MOCKOLLA_LOAD_MS=1200
# Seconds a model stays loaded.
MOCKOLLA_KEEP_ALIVE=300
# Fixed seed: same prompt, same reply. Empty = random.
MOCKOLLA_SEED=
# Version reported by /api/version.
MOCKOLLA_VERSION=0.12.0
# Comma-separated model list for /api/tags.
MOCKOLLA_MODELS=llama3.2:3b,qwen3:8b,gemma3:4b,gpt-oss:20b,nomic-embed-text:latest
# true = unknown models get 404.
MOCKOLLA_STRICT_MODELS=false
# Embedding vector length.
MOCKOLLA_EMBED_DIM=768
# Access-Control-Allow-Origin. Empty disables CORS.
MOCKOLLA_CORS=*
# Chance 0..1 of injecting a fault.
MOCKOLLA_FAULT_RATE=0
# random | error500 | disconnect | hang | malformed
MOCKOLLA_FAULT_MODE=random
# Duration of a simulated /api/pull (ms).
MOCKOLLA_PULL_MS=4000
# Reply rules file, relative to this .env.
MOCKOLLA_RULES=rules.json
# mock = made-up replies | proxy = forward to a real Ollama | mixed = rules first, then Ollama
MOCKOLLA_MODE=mock
# The real Ollama for proxy and mixed modes, as OpenAI clients take it (ending in /v1).
MOCKOLLA_UPSTREAM=http://127.0.0.1:11434/v1
# true = save the real Ollama's replies (proxy and mixed modes) to the recordings file.
MOCKOLLA_RECORD=false
# true = answer recorded prompts with the recorded reply (mock and mixed modes).
MOCKOLLA_REPLAY=false
# Recorded replies, relative to this .env.
MOCKOLLA_RECORDINGS=recordings.json
